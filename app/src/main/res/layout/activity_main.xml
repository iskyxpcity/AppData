<?xml version="1.0" encoding="utf-8"?>
<!-- Theme shell only. No business content. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/splashMark"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Voyage splash mark"
            android:src="@drawable/ic_splash_mark_tinted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/lxgwwenkaigb_regular"
            android:text="Voyage Theme"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/lxgwwenkaigb_regular"
            android:text="主题壳：纸 + 刃 + 文楷，业务已搬空"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabTheme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="主题设置" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabScheme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="方案编辑" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabComponents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="组件展示" />
        </LinearLayout>

        <!-- Section: Theme settings -->
        <LinearLayout
            android:id="@+id/sectionTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/currentTint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/lxgwwenkaigb_regular"
                android:text="当前 Tint：01"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="显示模式"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeFollow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="跟随系统" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeLight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="浅色" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeDark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="深色" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPureBlack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="深色下用纯黑背景" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSplashFollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动画面跟随主题" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchIconFollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="桌面图标跟随主题" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchBubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="主题色消息气泡（仅主题开关）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="恢复主题默认值" />

            <LinearLayout
                android:id="@+id/tintList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Section: Scheme editor -->
        <LinearLayout
            android:id="@+id/sectionScheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="配色方案：预设配色列表（演示，无业务数据）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="配色风格"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStyleFaithful"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="忠于种子" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStyleVibrant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="缤纷" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="全部 9 档风格（Licj0 序号，见深挖报告 §2.2；仅忠于种子与缤纷有完整表，其余回落忠于种子）"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/styleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="圆角 / 字体 / 动效：见主题状态，圆角、字体大小、动效开关均已存入 ThemeStore；形状样式 7 档、色觉模式 9 档、阴影组、描边、反转、转场、图标底衬、悬浮底栏等键已在 ThemeStore 中，序号与中文名对应待标定（见深挖报告）"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAnimation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="动效与触感" />
        </LinearLayout>

        <!-- Section: Component showcase -->
        <LinearLayout
            android:id="@+id/sectionComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/showcaseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="卡片（跟随主题）"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <SeekBar
                        android:id="@+id/showcaseSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/showcaseChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Chip（跟随主题）" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/primaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="?attr/colorPrimary"
                android:fontFamily="@font/lxgwwenkaigb_regular"
                android:text="主按钮（当前方案 primary）"
                android:textColor="?attr/colorOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showcaseOutlinedButton"
                style="@style/Widget.Voyage.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="描边按钮（outline）" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/showcaseSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="开关（跟随主题）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showcaseDialogButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="打开对话框示例" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="列表示例（跟随主题）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="12dp"
                android:text="列表项 1 · surface_container"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceContainerHigh"
                android:padding="12dp"
                android:text="列表项 2 · surface_container_high"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/showcaseNavBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/colorSurfaceContainer"
                app:menu="@menu/showcase_nav" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

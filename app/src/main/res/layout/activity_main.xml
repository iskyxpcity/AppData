                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSchemeEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="进入配色方案子页面" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSchemeNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="新建配色" />

            <LinearLayout
                android:id="@+id/customSchemeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="点自定义配色可删除；点预设配色可切换 Tint"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="预设配色"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/presetSchemeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="动效：转场动效、背景动效、动效与触感（时长与插值器未解码，壳内仅开关）"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAnimation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="动效与触感" />
        </LinearLayout>

        <!-- Section: Component showcase (visual only; settings live in 主题设置 groups) -->
        <LinearLayout
            android:id="@+id/sectionComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/showcaseTopBar"
                style="@style/Widget.Voyage.TopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:elevation="4dp"
                app:title="顶栏示例"
                app:subtitle="阴影由“阴影 · 顶栏”开关控制" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/showcaseFab"
                style="@style/Widget.Voyage.Fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:contentDescription="悬浮按钮示例"
                app:srcCompat="@drawable/ic_splash_mark" />

            <TextView
                android:id="@+id/componentState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="组件状态"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/showcaseBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:text="自己的消息使用主题色，关闭时为中性灰"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/showcaseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="卡片（跟随主题）"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <SeekBar
                        android:id="@+id/showcaseSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/showcaseChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Chip（跟随主题）" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/primaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="?attr/colorPrimary"
                android:fontFamily="@font/lxgwwenkaigb_regular"
                android:text="主按钮（当前方案 primary）"
                android:textColor="?attr/colorOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showcaseOutlinedButton"
                style="@style/Widget.Voyage.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="描边按钮（outline）" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/showcaseSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="开关（跟随主题）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showcaseDialogButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="打开对话框示例" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="列表示例（跟随主题）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="12dp"
                android:text="列表项 1 · surface_container"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceContainerHigh"
                android:padding="12dp"
                android:text="列表项 2 · surface_container_high"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/showcaseNavBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/colorSurfaceContainer"
                app:menu="@menu/showcase_nav" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

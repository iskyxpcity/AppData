        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">760</item>
        <item name="postSplashScreenTheme">@style/Theme.Voyage</item>
    </style>


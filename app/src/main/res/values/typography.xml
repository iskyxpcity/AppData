<?xml version="1.0" encoding="utf-8"?>
<!--
  Typography — BASELINE RECONSTRUCTION, not Voyage original values.
  Source: THEME_DEEP_DIVE.md §3.2.
  Original app: 30 TextStyles = 15 roles + each role's Emphasized variant
  (display/headline/title/body/label x Large/Medium/Small + Emphasized),
  transformed at runtime by font-family choice + font-size scale (Lsa30).
  The per-role sp / weight / line-height originals were NOT decoded
  (default constructor uses helper-computed constants), so the sizes
  below are Material3 default typography as a baseline, with the
  Voyage font family (LXGW WenKai GB) applied. Do NOT present these
  numbers as Voyage originals.
  Font family: @font/lxgwwenkaigb_regular (original app's only bundled
  font file; the exact DEX binding of that file to a font family was
  NOT traced — see THEME_DEEP_DIVE.md §3.2 — so this binding is a
  reconstruction, not a proven original binding).
-->
<resources>
    <!-- Display -->
    <dimen name="text_display_large">57sp</dimen>
    <dimen name="text_display_medium">45sp</dimen>
    <dimen name="text_display_small">36sp</dimen>
    <!-- Headline -->
    <dimen name="text_headline_large">32sp</dimen>
    <dimen name="text_headline_medium">28sp</dimen>
    <dimen name="text_headline_small">24sp</dimen>
    <!-- Title -->
    <dimen name="text_title_large">22sp</dimen>
    <dimen name="text_title_medium">16sp</dimen>
    <dimen name="text_title_small">14sp</dimen>
    <!-- Body -->
    <dimen name="text_body_large">16sp</dimen>
    <dimen name="text_body_medium">14sp</dimen>
    <dimen name="text_body_small">12sp</dimen>
    <!-- Label -->
    <dimen name="text_label_large">14sp</dimen>
    <dimen name="text_label_medium">12sp</dimen>
    <dimen name="text_label_small">11sp</dimen>
    <!-- Emphasized variants: same sizes, bold weight in styles.xml.
         Font-size scale (ThemeStore.font_size): 0 = 1.0x, 1 = 1.15x.
         Scale factors are shell reconstruction, not decoded originals. -->
</resources>

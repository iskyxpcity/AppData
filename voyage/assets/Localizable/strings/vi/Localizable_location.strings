"O105493_01"="Tham số Context không được là null";
"O105493_02"="Gọi dịch vụ định vị nền, thiếu quyền: android.permission.FOREGROUND_SERVICE";
"O105493_03"="Thông báo Lỗi";
"O105493_04"="Thêm hàng rào địa lý thất bại";
"O105493_05"="Tọa độ không hợp lệ. Vĩ độ đã truyền: ";
"O105493_06"="Kinh độ truyền vào";
"O105493_07"="Định vị thất bại";
"O105493_08"="Quyền truy cập vị trí đã bị vô hiệu hóa. Vui lòng cấp quyền truy cập vị trí cho ứng dụng. #1201";
"O105493_09"="Vui lòng kiểm tra xem dịch vụ có được cấu hình trong tệp cấu hình không và thẻ service trong manifest có được cấu hình bên trong thẻ application không #1003";
"O105493_10"="Vui lòng đến";
"O105493_11"="Xem mô tả mã lỗi";
"O105493_12"="Chi tiết Lỗi";
"O105493_13"="Trạm gốc hiện tại là trạm gốc giả mạo và không phát hiện được Wi-Fi. Vui lòng di chuyển đến khu vực có phủ sóng Wi-Fi tốt hơn #0204";
"O105493_14"="Dịch vụ định vị chưa được bật. Vui lòng bật công tắc dịch vụ định vị trong Cài đặt.#1206";
"O105493_15"="Định vị mạng thất bại. Vui lòng kiểm tra xem thiết bị có lắp thẻ SIM hay không, dữ liệu di động có được bật hay không, hoặc mô-đun Wi-Fi có được bật hay không.";
"O105493_16"="Định vị GPS thất bại do tín hiệu GPS kém. Đề nghị di chuyển thiết bị đến khu vực ngoài trời tương đối thoáng và thử lại.";
"O105493_17"="Wi-Fi đã bị tắt trong chế độ máy bay. Vui lòng tắt chế độ máy bay hoặc bật Wi-Fi. #1801";
"O105493_18"="Không phát hiện thấy thẻ SIM và công tắc Wi-Fi đang tắt. Vui lòng bật công tắc Wi-Fi hoặc lắp thẻ SIM #1901";
"O105493_19"="Định vị bù không thành công, không trúng bộ nhớ đệm";
"O105493_20"="Định vị hệ thống hiện không khả dụng #2003";
"O105493_21"="Lỗi Khác";
"O105493_22"="Tham số quan trọng bị trống";
"O105493_23"="Thông tin WIFI không đủ";
"O105493_24"="Đã xảy ra ngoại lệ khi lấy tham số yêu cầu";
"O105493_25"="Lỗi kết nối mạng";
"O105493_26"="Lỗi phân tích dữ liệu";
"O105493_27"="Lỗi kết quả định vị";
"O105493_28"="Lỗi KEY";
"O105493_29"="Ngoại lệ khởi tạo";
"O105493_30"="Không thể khởi động dịch vụ định vị";
"O105493_31"="Thiếu quyền truy cập vị trí";
"O105493_32"="Thông tin trạm gốc không chính xác. Vui lòng kiểm tra xem thẻ SIM đã được lắp vào chưa.";
"O105493_33"="Vị trí hiện tại được trả về là từ phần mềm mô phỏng. Vui lòng đóng phần mềm mô phỏng hoặc bật tính năng mô phỏng trong tùy chọn.";
"O105493_34"="Định vị thất bại. Wi-Fi đã bị tắt trong Chế độ máy bay. Vui lòng tắt Chế độ máy bay hoặc bật Wi-Fi.";
"O105493_35"="Định vị thất bại. Không phát hiện thẻ SIM và Wi-Fi đã bị tắt. Vui lòng bật Wi-Fi hoặc lắp thẻ SIM.";
"O105493_36"="Định vị mờ thất bại. Vui lòng xem thông báo lỗi/mô tả chi tiết để biết thêm chi tiết.";
"O105493_37"="Định vị tiết kiệm năng lượng không được hỗ trợ dưới quyền mơ hồ #2001";
"O105493_38"="Giải mã dữ liệu thất bại #0503";
"O105493_39"="Lỗi mạng, lỗi yêu cầu #0403";
"O105493_40"="Lỗi mạng, kết nối quá thời gian#0402";
"O105493_41"="Mạng bất thường, lỗi mã trạng thái #0404";
"O105493_42"="Lỗi mạng, chưa kết nối Internet. Vui lòng kết nối mạng.#0401";
"O105493_43"="Thiết bị của bạn không có mô-đun GPS hoặc mô-đun GPS bị lỗi. Không thể định vị bằng GPS.";
"O105493_44"="Cài đặt của bạn đã tắt quyền định vị GPS. Bật quyền định vị GPS giúp cải thiện độ chính xác định vị.";
"O105493_45"="Chế độ định vị hiện tại trên thiết bị của bạn không bao gồm định vị GPS. Chọn chế độ có hỗ trợ GPS sẽ giúp tăng độ chính xác khi định vị.";
"O105493_46"="Chức năng định vị GPS đã bị tắt trên thiết bị của bạn. Bật GPS sẽ giúp tăng độ chính xác khi định vị.";
"O105493_47"="Tín hiệu GPS hiện tại yếu, việc cập nhật vị trí có thể bị trì hoãn.";
"O105493_48"="Thiết bị của bạn chưa kết nối mạng và không thể định vị dựa trên mạng.";
"O105493_49"="Kết nối mạng của thiết bị không tốt. Định vị qua mạng có thể bị trễ.";
"O105493_50"="Wi-Fi trên thiết bị của bạn đã tắt. Bật Wi-Fi có thể giúp cải thiện độ chính xác vị trí.";
"O105493_51"="Trạm phát sóng hiện tại là trạm giả và Wi-Fi đã bị tắt. Vui lòng bật Wi-Fi trong Cài đặt.#0203";
"O105493_52"="Bạn đang kết nối với mạng yêu cầu đăng nhập. Vui lòng xác nhận rằng bạn đã đăng nhập mạng.#0501";
"O105493_53"="Yêu cầu có thể đã bị chiếm quyền điều khiển.#0502";
"O105493_54"="Quyền lấy thông tin trạm phát sóng và Wi-Fi đều bị vô hiệu hóa. Vui lòng bật quyền định vị của ứng dụng trong phần mềm bảo mật của bạn.#1202";
"O105493_55"="Wi-Fi đã bị tắt và quyền lấy thông tin trạm phát sóng đã bị vô hiệu hóa. Vui lòng bật quyền định vị của ứng dụng trong phần mềm bảo mật hoặc bật Wi-Fi.#1204";
"O105493_56"="Danh sách Wi-Fi thu được trống và quyền lấy thông tin trạm phát sóng đã bị vô hiệu hóa. Vui lòng bật quyền định vị của ứng dụng trong phần mềm bảo mật của bạn.#1205";
"O105493_57"="Không thu được thông tin trạm phát sóng và Wi-Fi đã bị tắt. Vui lòng bật Wi-Fi trước khi thực hiện định vị.#1301";
"O105493_58"="Không thu được thông tin trạm phát sóng và Wi-Fi. Vui lòng kiểm tra xem ứng dụng đã được cấp quyền định vị chưa.";
"O105493_59"="Hoặc chưa cấp quyền định vị nền khi chạy ở chế độ nền.";
"O105493_60"="Không thu được thông tin trạm phát sóng và Wi-Fi. Vui lòng di chuyển đến khu vực có phủ sóng Wi-Fi. Nếu bạn chắc chắn khu vực hiện tại có Wi-Fi, vui lòng kiểm tra xem ứng dụng đã được cấp quyền định vị chưa.";
"O105493_61"="Trạm phát sóng hiện tại là trạm giả và quyền truy cập Wi-Fi đã bị vô hiệu hóa. Vui lòng bật quyền định vị của ứng dụng trong phần mềm bảo mật của bạn.#0201";
"O105493_62"="Trạm phát sóng hiện tại là trạm giả và quyền truy cập Wi-Fi đã bị vô hiệu hóa. Vui lòng bật quyền định vị của ứng dụng trong phần mềm bảo mật của bạn.#0201";
